@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT TARGET protobuf::libprotobuf)
    find_dependency(Protobuf)
endif()
find_dependency(Threads)

# The build uses vendored protobuf targets, while installed consumers resolve
# their own Protobuf package above. Keep that implementation target out of the
# libghidra export set and bridge the installed link interface through this
# package-local imported target.
if(NOT TARGET libghidra::_protobuf)
    add_library(libghidra::_protobuf INTERFACE IMPORTED)
    set_property(TARGET libghidra::_protobuf PROPERTY
        INTERFACE_LINK_LIBRARIES
        "protobuf::libprotobuf"
    )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/libghidraTargets.cmake")

check_required_components(libghidra)
