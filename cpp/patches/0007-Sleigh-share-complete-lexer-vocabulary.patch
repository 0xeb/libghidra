+package ghidra.sleigh.grammar;
+
+import static org.junit.Assert.*;
+import java.lang.reflect.Field;
+import org.antlr.runtime.ANTLRStringStream;
+import org.junit.Test;
+
+public class SleighLexerVocabularyTest {
+    @Test
+    public void testEveryLexerUsesParserTokenNumbers() throws Exception {
+        for (Class<?> lexer : new Class<?>[] {BaseLexer.class, DisplayLexer.class,
+                SemanticLexer.class, SemanticLexerHex.class, SemanticLexerIdHex.class}) {
+            for (Field field : lexer.getFields()) {
+                if (field.getType() == int.class && java.lang.reflect.Modifier.isStatic(field.getModifiers())) {
+                    Field parserToken;
+                    try {
+                        parserToken = SleighParser.class.getField(field.getName());
+                    } catch (NoSuchFieldException ignored) {
+                        continue; // ANTLR implementation constants are not grammar tokens.
+                    }
+                    assertEquals(lexer.getSimpleName() + "." + field.getName(),
+                        parserToken.getInt(null), field.getInt(null));
+                }
+            }
+        }
+    }
+
+    @Test
+    public void testBaseLexerUnderscoreAndWhitespace() {
+        BaseLexer lexer = new BaseLexer(new ANTLRStringStream("_ name"));
+        lexer.setEnv(new ParsingEnvironment(new LineArrayListWriter()));
+        assertEquals(SleighParser.UNDERSCORE, lexer.nextToken().getType());
+        assertEquals(SleighParser.WS, lexer.nextToken().getType());
+        assertEquals(SleighParser.IDENTIFIER, lexer.nextToken().getType());
+    }
+}
