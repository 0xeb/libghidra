+package ghidra.app.plugin.core.analysis;
+
+import static org.junit.Assert.*;
+import org.junit.Test;
+import ghidra.app.util.bin.InvalidDataException;
+import ghidra.app.util.importer.MessageLog;
+import ghidra.program.database.ProgramBuilder;
+import ghidra.test.AbstractGhidraHeadlessIntegrationTest;
+import ghidra.util.task.TaskMonitor;
+
+public class MingwRelocationAnalyzerTest extends AbstractGhidraHeadlessIntegrationTest {
+    @Test
+    public void testUnlabeledEmptyImageIsNotAnAnalysisFailure() throws Exception {
+        ProgramBuilder builder = new ProgramBuilder("empty", ProgramBuilder._X64, "windows", null);
+        try {
+            builder.createMemory(".rdata", "1000", 0x100);
+            var program = builder.getProgram();
+            int tx = program.startTransaction("analyze");
+            try {
+                assertTrue(new MingwRelocationAnalyzer().added(program, program.getMemory(),
+                    TaskMonitor.DUMMY, new MessageLog()));
+                assertEquals("Unsupported", program.getOptions("Program Information")
+                    .getString("MinGW Relocations", null));
+            } finally {
+                program.endTransaction(tx, true);
+            }
+        } finally {
+            builder.dispose();
+        }
+    }
+
+    @Test
+    public void testLabeledEmptyListRemainsSupported() throws Exception {
+        ProgramBuilder builder = new ProgramBuilder("labeled", ProgramBuilder._X64, "windows", null);
+        try {
+            builder.createMemory(".rdata", "1000", 0x100);
+            builder.createLabel("1010", MinGWPseudoRelocList.PSEUDO_RELOC_LIST_START_NAME);
+            builder.createLabel("1010", MinGWPseudoRelocList.PSEUDO_RELOC_LIST_END_NAME);
+            assertTrue(new MinGWPseudoRelocationHandler(builder.getProgram(), TaskMonitor.DUMMY)
+                .processRelocations(new MessageLog(), TaskMonitor.DUMMY));
+        } finally {
+            builder.dispose();
+        }
+    }
+
+    @Test
+    public void testNonemptyLabeledListStillAppliesRelocations() throws Exception {
+        ProgramBuilder builder = new ProgramBuilder("relocated", ProgramBuilder._X64, "windows", null);
+        try {
+            builder.createMemory(".rdata", "1000", 0x100);
+            builder.setBytes("1010", "42 00 00 00 80 10 00 00");
+            builder.setBytes("1080", "01 00 00 00");
+            builder.createLabel("1010", MinGWPseudoRelocList.PSEUDO_RELOC_LIST_START_NAME);
+            builder.createLabel("1018", MinGWPseudoRelocList.PSEUDO_RELOC_LIST_END_NAME);
+            var program = builder.getProgram();
+            int tx = program.startTransaction("relocate");
+            try {
+                assertTrue(new MinGWPseudoRelocationHandler(program, TaskMonitor.DUMMY)
+                    .processRelocations(new MessageLog(), TaskMonitor.DUMMY));
+                assertEquals(0x43, program.getMemory().getInt(builder.addr("1080")));
+            } finally {
+                program.endTransaction(tx, true);
+            }
+        } finally {
+            builder.dispose();
+        }
+    }
+
+    @Test
+    public void testMissingEndLabelIsStillMalformed() throws Exception {
+        ProgramBuilder builder = new ProgramBuilder("malformed", ProgramBuilder._X64, "windows", null);
+        try {
+            builder.createMemory(".rdata", "1000", 0x100);
+            builder.createLabel("1010", MinGWPseudoRelocList.PSEUDO_RELOC_LIST_START_NAME);
+            try {
+                new MinGWPseudoRelocList(builder.getProgram(), TaskMonitor.DUMMY);
+                fail("Missing end label must fail");
+            } catch (InvalidDataException expected) {
+                assertFalse(expected instanceof MinGWPseudoRelocListNotFoundException);
+                assertTrue(expected.getMessage().contains("Missing MinGW"));
+            }
+        } finally {
+            builder.dispose();
+        }
+    }
+}
