+	@Test
+	public void testSharedPrefixDeclaratorsAndAttributes() throws Exception {
+		CParser parser = new CParser();
+		Structure dt = (Structure) parser.parse(
+			"struct PrefixProbe { int a[2][3] [[deprecated]]; int b; };");
+		assertEquals(2, dt.getNumComponents());
+		assertEquals("a", dt.getComponent(0).getFieldName());
+		assertEquals(24, dt.getComponent(0).getLength());
+		assertEquals("b", dt.getComponent(1).getFieldName());
+		parser.parse("int values[] = {1,2,};");
+		parser.parse("extern \"C\" int call(const int * const *p, int (*cb)(int), ...);");
+	}
+
+	@Test
+	public void testAdjacentStringLiteralValue() throws Exception {
+		CParser parser = new CParser();
+		parser.ReInit(new java.io.StringReader("\"a\" \"b\""));
+		assertEquals("\"ab\"", parser.MultiLineString().image);
+	}
 
 	public CParserTest() {
 		super();
