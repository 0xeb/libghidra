+/// \brief Replace the fields of an existing structure in place
+///
+/// Unlike setFields(), the structure may already be complete. It keeps its identity -- name, id,
+/// and every pointer, array or prototype that refers to it -- so an edit reaches every user of the
+/// data-type, where destroying and recreating it would leave those users pointing at freed memory.
+/// Typedefs of the structure (which are copies of it) receive the same fields.
+/// Field offsets are taken as given; the caller supplies the new size and alignment.
+/// \param ct is the structure to redefine
+/// \param fd is the new list of fields
+/// \param bit is the new list of bitfields
+/// \param newSize is the new size of the structure in bytes
+/// \param newAlign is the new alignment of the structure
+void TypeFactory::redefineStruct(TypeStruct *ct,const vector<TypeField> &fd,const vector<TypeBitField> &bit,
+				 int4 newSize,int4 newAlign)
+{
+  uint4 newFlags = bit.empty() ? 0 : (uint4)Datatype::has_bitfields;
+  for(int4 i=0;i<fd.size();++i) {
+    if (fd[i].type->getMetatype() == TYPE_VOID)
+      throw LowlevelError("Illegal field void in structure: "+ct->getName());
+    if (fd[i].type->hasBitfields())
+      newFlags |= Datatype::has_bitfields;
+  }
+  vector<TypeStruct *> targets(1,ct);
+  for(DatatypeSet::const_iterator iter=tree.begin();iter!=tree.end();++iter) {
+    Datatype *dt = *iter;
+    if (dt != ct && dt->getTypedef() == ct && dt->getMetatype() == TYPE_STRUCT)
+      targets.push_back((TypeStruct *)dt);
+  }
+  for(int4 i=0;i<targets.size();++i) {
+    TypeStruct *st = targets[i];
+    tree.erase(st);		// The tree is ordered by the fields
+    st->flags &= ~(uint4)(Datatype::has_bitfields | Datatype::needs_resolution);
+    st->setFields(fd,bit,newSize,newAlign);
+    st->flags |= newFlags;
+    tree.insert(st);
+    recalcPointerSubmeta(st, SUB_PTR);
+    recalcPointerSubmeta(st, SUB_PTR_STRUCT);
+  }
+}
