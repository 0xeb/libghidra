# Normalize all text to LF in repo and on checkout.
* text=auto eol=lf

# AGENTS.md is private agent guidance and must not ship in release archives.
AGENTS.md export-ignore
**/AGENTS.md export-ignore

# Force LF for source files.
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.cc text eol=lf
*.c text eol=lf
*.py text eol=lf
*.java text eol=lf
*.proto text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.cmake text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
CMakeLists.txt text eol=lf

# Unified-diff context prefixes are syntax, including blank lines and tab indentation.
cpp/patches/*.patch -whitespace

# protoc 29.3's Java generator emits trailing spaces in generated source.
ghidra-extension/src/main/generated/**/*.java whitespace=-trailing-space
